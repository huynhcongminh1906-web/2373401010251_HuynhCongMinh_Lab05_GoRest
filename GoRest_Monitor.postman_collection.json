{
  "info": {
    "_postman_id": "a62fa5db-6f9e-43be-a597-a1d32328c29c",
    "name": "MSSV_HoTen_GoRest_Monitor",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Warm-up (khong kiem tra, chi mo ket noi)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/users?per_page=1"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Request khoi dong: thiet lap san DNS/TCP/TLS de request chinh do dung thoi gian phan hoi API.",
              "console.log('Warm-up response time: ' + pm.response.responseTime + 'ms');"
            ]
          }
        }
      ]
    },
    {
      "name": "GET /users - Health & Response Time",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "url": "{{base_url}}/users"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
              "pm.test('Response time < 800ms', () => pm.expect(pm.response.responseTime).to.be.below(800));",
              "pm.test('Response la mang JSON', () => pm.expect(pm.response.json()).to.be.an('array'));"
            ]
          }
        }
      ]
    }
  ]
}